[flake8]
max-line-length = 127
max-complexity = 10
exclude = .git,__pycache__,.venv,build,dist,src,assets,licenses,docs
extend-ignore = E203,W503

# Les dictionnaires de traduction dépassent naturellement 127 colonnes ; les
# scripts d'outillage configurent Qt avant d'importer PySide6.
per-file-ignores =
    app/i18n.py: E501
    app/ytdlp_runtime.py: C901
    tools/*.py: E402
