# Normalise les fins de ligne et marque les binaires.
* text=auto eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

*.ico binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.zip binary
*.7z binary
*.exe binary
*.dll binary
*.pyd binary
*.whl binary

# PyInstaller : le fichier .spec est du Python.
*.spec text linguist-language=Python
